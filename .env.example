# ===== A4S 配置模板 =====
# 复制为 .env 后填写。此文件可提交到 git，.env 不可。

# --- 应用 ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- 数据库（SQLite 默认；未来切 PostgreSQL 只需改这一行）---
DATABASE_URL=sqlite:///./data/app.db

# --- LLM（OpenAI 兼容协议）---
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60

# --- Embedding ---
# local = 本地 BGE（离线、零成本，首次需下载模型）
# cloud = 云端 OpenAI 兼容 embedding 接口
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=512
# 模型下载源。国内直连 huggingface.co 会超时，默认走镜像；
# 海外或有代理的环境可置空，改用 huggingface_hub 自身默认。
HF_ENDPOINT=https://hf-mirror.com

# --- SMTP 邮件 ---
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --- 定时回顾 ---
SCHEDULER_ENABLED=false
SCHEDULER_CRON_DAY_OF_WEEK=mon
SCHEDULER_CRON_HOUR=9
SCHEDULER_CRON_MINUTE=0
