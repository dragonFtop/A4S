{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A4S",
  "version": "0.2.0",
  "identifier": "com.a4s.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "A4S 本地知识库",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "shortDescription": "A4S 本地知识库客户端",
    "longDescription": "本地优先的个人知识库，可选接入服务端进行小组共享与联邦检索。"
  }
}
